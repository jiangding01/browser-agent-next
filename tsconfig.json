{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@browser-agent-next/core": ["packages/core/src/index.ts"],
      "@browser-agent-next/refs": ["packages/refs/src/index.ts"],
      "@browser-agent-next/policy": ["packages/policy/src/index.ts"],
      "@browser-agent-next/runtime": ["packages/runtime/src/index.ts"],
      "@browser-agent-next/eval": ["packages/eval/src/index.ts"],
      "@browser-agent-next/perception": ["packages/perception/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts"]
}
