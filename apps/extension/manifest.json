{
  "manifest_version": 3,
  "name": "Browser Agent Next",
  "description": "Agent-native browser runtime foundation for real Chrome.",
  "version": "0.1.0",
  "minimum_chrome_version": "106",
  "permissions": [
    "tabs",
    "webNavigation",
    "debugger",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "Browser Agent 审批",
    "default_popup": "operator-approval.html"
  },
  "storage": {
    "managed_schema": "enterprise-policy-schema.json"
  }
}
